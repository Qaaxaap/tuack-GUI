{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuack-GUI",
  "version": "1.0.0-rc1",
  "identifier": "com.tuackng.tuackgui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tuack-GUI",
        "width": 800,
        "height": 600,
        "theme": "Dark",
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
